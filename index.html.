<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Кубик Сочный GOLD VIP</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090909;color:#ffd700;font-family:Arial;text-align:center}
h1{margin-top:35px;font-size:30px}
.machine{margin:25px 12px;padding:25px;background:#171717;border:2px solid #d4af37;border-radius:20px;box-shadow:0 0 25px #a87900}
.dice{font-size:65px;margin:30px 0}
button{background:linear-gradient(45deg,#a87900,#ffe68a);color:#111;border:0;border-radius:12px;padding:18px 35px;font-size:22px;font-weight:bold}
#result{font-size:22px;margin:25px}
</style>
</head>
<body>
<h1>👑 КУБИК СОЧНЫЙ 👑</h1>
<p>GOLD VIP CASINO</p>
<div class="machine">
<h2>ТВОЯ УДАЧА!</h2>
<div class="dice" id="dice">🎲 🎲 🎲</div>
<button onclick="play()">ИГРАТЬ</button>
<div id="result">Нажми и испытай удачу!</div>
<p>Монеты: <span id="coins">1000</span></p>
</div>
<script>
let coins=1000;
function play(){
if(coins<10){
document.getElementById('result').textContent='Монеты закончились!';
return;
}
coins-=10;
let symbols=['🎲','🧊','💎','👑','⭐','🎰'];
let a=Array.from({length:3},()=>symbols[Math.floor(Math.random()*symbols.length)]);
document.getElementById('dice').textContent=a.join(' ');
if(a.every(x=>x===a[0])){
coins+=100;
document.getElementById('result').textContent='👑 ДЖЕКПОТ! +100 монет!';
}else{
document.getElementById('result').textContent='Попробуй ещё раз!';
}
document.getElementById('coins').textContent=coins;
}
</script>
</body>
</html>
